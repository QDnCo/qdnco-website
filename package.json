{
  "name": "portfolio-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "site": "node scripts/build/sync-faq-schema.mjs && node scripts/generate/make-legal.mjs && node scripts/generate/make-guides.mjs && node scripts/build/build-dist.mjs && node scripts/build/prerender.mjs",
    "audit": "node scripts/audit/audit-responsive.mjs && node scripts/audit/audit-touch.mjs && node scripts/audit/audit-headroom.mjs && node scripts/audit/audit-fit.mjs && node scripts/audit/audit-seo.mjs && node scripts/audit/audit-links.mjs && node scripts/audit/audit-deadcode.mjs && node scripts/audit/verify.mjs",
    "deploy": "node scripts/deploy/deploy.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "faq": "node scripts/build/sync-faq-schema.mjs --check",
    "verify": "node scripts/audit/verify.mjs",
    "seo": "node scripts/audit/audit-seo.mjs",
    "legal": "node scripts/generate/make-legal.mjs",
    "gaps": "node scripts/audit/audit-gaps.mjs",
    "fit": "node scripts/audit/audit-fit.mjs",
    "guides": "node scripts/generate/make-guides.mjs",
    "test": "node --test tests/lead-capture.test.mjs tests/estimate.test.mjs"
  },
  "dependencies": {
    "framer-motion": "^13.0.0",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "basic-ftp": "^6.2.0",
    "oxlint": "^1.75.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.25",
    "puppeteer-core": "^25.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
