# Generated by build-dist.mjs — do not edit on the server, it is overwritten.
# Canonical host. www.qdnco.com currently answers 200 with the same content,
# which indexes the site twice and splits every signal between two hosts. The
# canonical tag mitigates it; a 301 removes it. HTTPS is forced for the same
# reason, and HSTS tells browsers to stop asking.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.qdnco\.com$ [NC]
  RewriteRule ^(.*)$ https://qdnco.com/$1 [R=301,L]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://qdnco.com/$1 [R=301,L]
</IfModule>
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# LiteSpeed keeps a server-side page cache. For a static page it buys nothing
# and it is what serves a stale index.html after a deploy.
<IfModule LiteSpeed>
  CacheDisable public /
</IfModule>

<IfModule mod_headers.c>
  # HTML: always revalidate.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>

  # Assets: cache for a day. Not "immutable" — these filenames carry no hash,
  # so a year-long cache would strand any updated logo or screenshot.
  <FilesMatch "\.(png|jpe?g|svg|webp|woff2?|json)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# robots.txt and sitemap.xml should never be served stale to a crawler.
<FilesMatch "^(robots\.txt|sitemap\.xml)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </IfModule>
</FilesMatch>

# Branded 404 (Hostinger default template carried third-party trackers).
ErrorDocument 404 /404.html

# Web app manifest was served as text/plain.
AddType application/manifest+json .webmanifest

# ── Legacy URLs from the pre-2026 site (Google still lists some as sitelinks) → 301 to the live equivalent ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^inner_pages/blog\.html$ /guides/index.html [R=301,L]
  RewriteRule ^inner_pages/(blog|blogs|insights|articles|resources)[^/]*$ /guides/index.html [R=301,L]
  RewriteRule ^(blog|blogs|insights|articles|resources)(/.*)?$ /guides/index.html [R=301,L]
  RewriteRule ^inner_pages/(about|about-us|team|who-we-are)[^/]*$ /about/ [R=301,L]
  RewriteRule ^(about-us|team)(\.html)?/?$ /about/ [R=301,L]
  RewriteRule ^inner_pages/(portfolio|work|projects|case-stud)[^/]*$ /work/index.html [R=301,L]
  RewriteRule ^inner_pages/(pricing|plans|packages)[^/]*$ /pricing/index.html [R=301,L]
  RewriteRule ^inner_pages/(privacy)[^/]*$ /legal/privacy.html [R=301,L]
  RewriteRule ^inner_pages/(terms)[^/]*$ /legal/terms.html [R=301,L]
  RewriteRule ^inner_pages/(contact|contact-us|get-in-touch)[^/]*$ https://qdnco.com/#contact [R=301,NE,L]
  RewriteRule ^inner_pages/(services?|what-we-do|solutions)[^/]*$ https://qdnco.com/#services [R=301,NE,L]
  RewriteRule ^inner_pages(/.*)?$ / [R=301,L]
</IfModule>
